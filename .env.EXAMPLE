# researchagen — секреты профиля. Скопируйте в .env и заполните.
# install.ps1 / install.sh создают этот файл автоматически по ответам в интерфейсе.
# НИКОГДА не коммитьте .env — он в .gitignore и жёстко исключён установщиком Hermes.

# --- Telegram: ОТДЕЛЬНЫЙ бот, не тот, что у основного профиля -----------------
# Два профиля с одним токеном не запустятся: Hermes блокирует второй gateway
# (token lock) и назовёт конфликтующий профиль.
TELEGRAM_BOT_TOKEN=
# chat_id группы/лички, где живёт штаб (дайджесты, вердикты, прогресс)
TELEGRAM_HOME_CHANNEL=
# оба пользователя через запятую — один бот, одна статистика, одни настройки
TELEGRAM_ALLOWED_USERS=
# необязательно: thread_id топика «📊 Штаб» — туда падают cron-доставки
TELEGRAM_CRON_THREAD_ID=
# необязательно: thread_id топика «🎭 Курилка» — туда пишет чат агентов (tools/crew.py)
TELEGRAM_CREW_THREAD_ID=

# --- Локальная модель (Ollama / llama.cpp / vLLM, OpenAI-совместимый endpoint) ------
RESEARCHAGEN_MODEL_BASE_URL=http://localhost:11434/v1
RESEARCHAGEN_MODEL_NAME=qwen3:27b
RESEARCHAGEN_MODEL_API_KEY=ollama

# --- Корневая рабочая папка профиля (абсолютный путь) --------------------
# Windows: C:\Users\<вы>\researchagen     macOS: /Users/<вы>/researchagen
RESEARCHAGEN_HOME=

# --- Необязательно: облако только для aux-задач (judge, compression) --------
# Основной цикл всегда идёт на локальной Qwen3 — облако никогда не обязательно.
OPENROUTER_API_KEY=

# --- Необязательно: бесплатные research-API без ключей работают и без этого
SEMANTIC_SCHOLAR_API_KEY=
